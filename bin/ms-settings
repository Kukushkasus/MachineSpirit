#!/usr/bin/env python3
# [ PURITY SEAL ] Validate before invoking the machine.
import copy, fcntl, json, os, re, subprocess, sys, tempfile, time
from pathlib import Path
HOME = Path.home()
CONF = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config'))
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'machinespirit'
PATH = CONF / 'machinespirit/settings.json'
DEFAULT = dict(version=1, layouts=['us'], layoutSwitch='grp:alt_shift_toggle', primaryOutput='', monitors=[], reducedMotion=False, lowPower=False, blur=True, lockSeconds=600, screenOffSeconds=900, bindings={})

def atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f: f.write(value); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp, 0o600); os.replace(tmp, path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def canonical_key(text):
    parts=[x.strip().upper().replace("CTRL","CONTROL") for x in text.split("+") if x.strip()]
    mods={"SUPER","ALT","CONTROL","SHIFT","MOD2","MOD3","MOD5"}
    keys=[x for x in parts if x not in mods]
    key=keys[-1] if keys else ""
    if key=="CODE:61": key="SLASH"
    if re.fullmatch(r"CODE:1[0-9]",key): key=str((int(key[5:])-9)%10)
    return "+".join(sorted(x for x in parts if x in mods)+[key]) if parts else ""

def validate(d):
    if not isinstance(d, dict) or (type(d.get('version')) is not int or d.get('version') != 1): raise ValueError('Unsupported settings version')
    d = dict(copy.deepcopy(DEFAULT), **d)
    if not isinstance(d['layouts'], list) or not 1 <= len(d['layouts']) <= 4 or any(not isinstance(x,str) or not re.fullmatch('[a-z]{2,8}',x) for x in d['layouts']): raise ValueError('Choose 1–4 XKB layout names, e.g. us, ru')
    if not isinstance(d['layoutSwitch'],str) or not re.fullmatch('[a-zA-Z0-9_:,+-]*', d['layoutSwitch']): raise ValueError('Invalid XKB switching option')
    symbols=Path('/usr/share/X11/xkb/symbols')
    if symbols.is_dir() and any(not (symbols/x).is_file() for x in d['layouts']): raise ValueError('Unknown XKB keyboard layout')
    if not isinstance(d['primaryOutput'],str) or not re.fullmatch('[a-zA-Z0-9_.:-]*',d['primaryOutput']): raise ValueError('Invalid output name')
    for key in ['reducedMotion','lowPower','blur']:
        if type(d[key]) is not bool: raise ValueError(key + ' must be boolean')
    for key in ['lockSeconds','screenOffSeconds']:
        if type(d[key]) is not int or not 30 <= d[key] <= 86400: raise ValueError(key + ' must be 30–86400 seconds')
    if d['screenOffSeconds'] < d['lockSeconds']: raise ValueError('Screen off must follow locking')
    if not isinstance(d['monitors'],list): raise ValueError('monitors must be a list')
    outputs = set()
    for m in d['monitors']:
        if not isinstance(m,dict) or not re.fullmatch('[a-zA-Z0-9_.:-]+',m.get('output','')): raise ValueError('Invalid monitor output')
        if m['output'] in outputs: raise ValueError('Duplicate monitor output')
        outputs.add(m['output'])
        if not re.fullmatch(r'preferred|\d{3,5}x\d{3,5}(?:@\d+(?:\.\d+)?)?',m.get('mode','preferred')): raise ValueError('Invalid monitor mode')
        if not re.fullmatch(r'auto|-?\d+x-?\d+',m.get('position','auto')): raise ValueError('Invalid position; use 0x0, 1920x0, etc.')
        if not isinstance(m.get('scale',1),(int,float)) or not .5 <= m.get('scale',1) <= 4: raise ValueError('Scale must be 0.5–4')
        if type(m.get('transform',0)) is not int or not 0 <= m.get('transform',0) <= 7: raise ValueError('Invalid rotation')
        if type(m.get('disabled',False)) is not bool: raise ValueError('disabled must be boolean')
    if d['monitors'] and all(m.get('disabled',False) for m in d['monitors']): raise ValueError('At least one monitor must remain enabled')
    if not isinstance(d['bindings'],dict): raise ValueError('bindings must be an object')
    values = []
    for old, new in d['bindings'].items():
        if not all(isinstance(x,str) and re.fullmatch('[A-Za-z0-9_:+ ,.-]*',x) for x in (old,new)): raise ValueError('Invalid key combination')
        if new:
            normalized = canonical_key(new)
            if normalized in values: raise ValueError('Duplicate key combination')
            values.append(normalized)
    return d

def read(): return validate(json.loads(PATH.read_text())) if PATH.exists() else copy.deepcopy(DEFAULT)
def lua(value):
    if isinstance(value,bool): return str(value).lower()
    if isinstance(value,(int,float)): return str(value)
    if isinstance(value,str): return json.dumps(value,ensure_ascii=True)
    if isinstance(value,dict): return '{' + ','.join('['+lua(k)+']='+lua(v) for k,v in value.items()) + '}'
    return '{' + ','.join(lua(v) for v in value) + '}'

def generate(d):
    lines = ['-- Generated by ms-settings. Edit settings.json or use Settings.', 'MS_BINDINGS = '+lua(d['bindings']), 'hl.config('+lua({'input':{'kb_layout':','.join(d['layouts']),'kb_options':d['layoutSwitch']},'animations':{'enabled':not(d['reducedMotion'] or d['lowPower'])},'decoration':{'blur':{'enabled':d['blur'] and not d['lowPower']}}})+')']
    for m in d['monitors']: lines.append('hl.monitor('+lua(m)+')')
    atomic(CONF / 'machinespirit/generated.lua','\n'.join(lines)+'\n')
    idle = f'''# Generated by ms-settings\ngeneral {{\n lock_cmd = ms-session lock\n before_sleep_cmd = ms-session lock\n after_sleep_cmd = ms-session resume\n}}\nlistener {{\n timeout = {d['lockSeconds']}\n on-timeout = ms-session lock\n}}\nlistener {{\n timeout = {d['screenOffSeconds']}\n on-timeout = hyprctl eval 'hl.dispatch(hl.dsp.dpms({{ state = "off" }}))'\n on-resume = hyprctl eval 'hl.dispatch(hl.dsp.dpms({{ state = "on" }}))'\n}}\n'''
    atomic(CONF / 'machinespirit/hypridle.conf', idle)

def reload():
    if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        subprocess.run(['hyprctl','reload'],check=True,stdout=subprocess.DEVNULL)
        errors=subprocess.check_output(['hyprctl','configerrors'],text=True).strip()
        if errors: raise ValueError('Compositor rejected configuration: '+errors[:300])

def rollback():
    p = STATE / 'settings-preview.json'
    if p.exists():
        old = json.loads(p.read_text())['old']; atomic(PATH,json.dumps(old,indent=2)); generate(old); p.unlink(); reload()

def main():
    cmd = sys.argv[1] if len(sys.argv)>1 else 'read'
    if cmd == 'watchdog':
        time.sleep(16)
        STATE.mkdir(parents=True,exist_ok=True)
        with (STATE/'settings.lock').open('w') as lock:
            fcntl.flock(lock,fcntl.LOCK_EX); rollback()
        return {}
    if cmd == 'read': return {'data':read()}
    if cmd == 'monitors': return {'monitors':json.loads(subprocess.check_output(['hyprctl','monitors','all','-j']))}
    if cmd == 'binds':
        binds = json.loads(subprocess.check_output(['hyprctl','binds','-j']))
        masks = [(64,'Super'),(8,'Alt'),(4,'Ctrl'),(1,'Shift')]
        rows = []; seen=set()
        for b in binds:
            if not b.get('description'): continue
            if b.get('dispatcher') == 'global' and 'super' in b.get('arg',''): continue
            key = b.get('key') or ('code:'+str(b.get('keycode',0)))
            combo = '+'.join([name for mask,name in masks if b.get('modmask',0)&mask]+[key])
            desc = b.get('description') or b.get('arg') or b.get('dispatcher','')
            if (combo,desc) not in seen: rows.append({'keys':combo,'description':desc}); seen.add((combo,desc))
        catalog = CONF / 'machinespirit/bindings.json'
        if catalog.exists():
            registered = json.loads(catalog.read_text())
            # Include original IDs for remapping, and any additional user binds from Hyprland.
            for row in registered:
                if row['keys']:
                    row['keys'] = row['keys'].replace('code:61','/')
                    row['keys'] = re.sub(r'code:(1[0-9])',lambda m:str((int(m[1])-9)%10),row['keys'])
            return {'bindings': registered + [r for r in rows if not any(r['description'] == b['description'] for b in registered)]}
        return {'bindings':rows}
    STATE.mkdir(parents=True,exist_ok=True)
    with (STATE/'settings.lock').open('w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        pending=STATE/'settings-preview.json'
        if cmd == 'confirm':
            if pending.exists(): pending.unlink()
            return {'data':read()}
        if cmd == 'revert': rollback(); return {'data':read()}
        if cmd == 'generate':
            if pending.exists(): rollback()
            generate(read()); return {'data':read()}
        if cmd != 'write': raise ValueError('Unknown settings operation')
        if pending.exists(): raise ValueError('Confirm or revert the current display preview first')
        new=validate(json.load(sys.stdin)); old=read()
        catalog = CONF / 'machinespirit/bindings.json'
        if catalog.exists():
            registered = json.loads(catalog.read_text())
            defaults = {r['original'] for r in registered}
            unknown = set(new['bindings']) - defaults
            if unknown: raise ValueError('Unknown original shortcut: ' + ', '.join(sorted(unknown)))
            assigned = {}
            for row in registered:
                actual = canonical_key(new['bindings'].get(row['original'],row['original']))
                if actual and actual in assigned: raise ValueError('Shortcut conflict: ' + actual)
                if actual: assigned[actual] = row['original']
        if new['monitors'] != old['monitors'] and os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
            connected = json.loads(subprocess.check_output(['hyprctl','monitors','all','-j']))
            enabled = [m for m in connected if not next((x.get('disabled',False) for x in new['monitors'] if x['output']==m['name']),False)]
            if not enabled: raise ValueError('At least one connected display must remain enabled')
        preview=new['monitors'] != old['monitors']
        if preview:
            atomic(pending,json.dumps({'old':old}))
            subprocess.Popen([sys.executable,str(Path(__file__).resolve()),'watchdog'],start_new_session=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,stdin=subprocess.DEVNULL)
        atomic(PATH,json.dumps(new,indent=2)); generate(new)
        try: reload()
        except Exception:
            atomic(PATH,json.dumps(old,indent=2)); generate(old)
            if pending.exists(): pending.unlink()
            try: reload()
            except Exception: pass
            raise
        return {'data':new,'preview':preview}
if __name__ == '__main__':
    try: print(json.dumps(main()))
    except Exception as e: print(json.dumps({'error':str(e)})); sys.exit(1)
