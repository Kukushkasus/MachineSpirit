#!/bin/sh
# [ PURITY SEAL ] Report only images that were captured.
set -eu
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
f=$(mktemp "$dir/$(date +%Y-%m-%d_%H-%M-%S)-XXXXXX.png")
trap 'rm -f "$f"' EXIT HUP INT TERM
case "${1:-region}" in
    region)
        geo=$(slurp -d -b '#0a0a0bb3' -c '#d9b45aff' -s '#33ff6622' -B '#0a0a0b00' -w 2) || exit 0
        grim -g "$geo" "$f" ;;
    full) grim "$f" ;;
    *) echo 'Usage: ms-screenshot region|full' >&2; exit 2 ;;
esac
[ -s "$f" ]
trap - EXIT HUP INT TERM
wl-copy < "$f"
if command -v notify-send >/dev/null; then notify-send -i "$f" 'Screenshot saved' "$f"; fi
