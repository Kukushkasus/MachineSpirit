#!/usr/bin/env python3
# [ PURITY SEAL ] Touch only the spirit entrusted to this session.
import fcntl, json, os, shutil, signal, subprocess, sys, time
from pathlib import Path
run=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp')) / ('machinespirit-'+str(os.getuid()))
run.mkdir(mode=0o700,exist_ok=True)
cmd=sys.argv[1] if len(sys.argv)>1 else 'start'
if cmd == 'resume':
    # Some DRM backends expose the output after logind's resume signal.
    for delay in (0, 1):
        time.sleep(delay)
        subprocess.run(['hyprctl','eval','hl.dispatch(hl.dsp.dpms({ state = "on" }))'],stdout=subprocess.DEVNULL)
    sys.exit(0)
PAM_SERVICE=os.environ.get('MS_PAM_SERVICE','/etc/pam.d/hyprlock')   # the stack both lock screens authenticate against (hyprlock package)
def lock_ipc(*args):
    try: r=subprocess.run(['quickshell','ipc','-c','machinespirit','call','lock',*args],capture_output=True,text=True,timeout=3)
    except (OSError,subprocess.TimeoutExpired): return None
    return r.stdout.strip() if r.returncode==0 else None
def quickshell_lock():
    """'ok': locked (or already), 'fallback': nothing was captured, hyprlock may be used, 'held': a lock may be held, start no other locker."""
    if not os.access(PAM_SERVICE,os.R_OK): return 'fallback'
    phase=lock_ipc('state')
    if phase in ('secure','locking'): return 'ok'
    if phase is None:
        # Quickshell does not answer. If it held the lock when it died, the compositor still keeps the screen locked and the
        # shell takes it over again when the supervisor restarts it; a second locker must not be started on top of that.
        return 'held' if (run/'locked').exists() else 'fallback'
    lock_ipc('lock')
    for _ in range(int(float(os.environ.get('MS_LOCK_WAIT','4'))*10)):
        time.sleep(.1)
        if lock_ipc('state')=='secure': return 'ok'
    # Not confirmed by the compositor: withdraw the request and prove nothing is held before falling back.
    after=lock_ipc('cancel')
    if after=='secure': return 'ok'
    return 'fallback' if after=='unlocked' else 'held'
def lock_held():
    """True while the screen is locked, or while a lock that outlived its shell may still be held."""
    phase=lock_ipc('state')
    return phase in ('secure','locking') or (phase is None and (run/'locked').exists())
LOCK_REFUSAL='The screen is locked. Unlock it first: changing or restarting the shell now could leave the lock without its screen. Nothing was changed.'
if cmd == 'locked': sys.exit(0 if lock_held() else 1)
if cmd == 'lock':
    with (run/'lockscreen.lock').open('w') as f:
        try: fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError: sys.exit(0)
        try: backend=json.loads((Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))/'machinespirit/settings.json').read_text()).get('lockBackend','quickshell')
        except (OSError,ValueError,AttributeError): backend='quickshell'
        if backend=='quickshell':
            result=quickshell_lock()
            if result=='ok': sys.exit(0)
            if result=='held': sys.exit('The screen may be locked by a locker that is not running. It stays locked. Start the shell again with ms-session start and it takes the lock over (a passphrase is still required); no second locker was started.')
        sys.exit(subprocess.call(['hyprlock']))
if cmd == 'restart':
    if lock_held(): sys.exit(LOCK_REFUSAL)
    restart_env=dict(os.environ)
    p=run/'supervisor.pid'
    if p.exists():
        pid=int(p.read_text())
        try:
            if b'ms-session' in Path(f'/proc/{pid}/cmdline').read_bytes():
                restart_env.update(dict(x.split('=',1) for x in Path(f'/proc/{pid}/environ').read_bytes().decode().split('\0') if '=' in x))
                os.kill(pid,signal.SIGTERM)
        except (FileNotFoundError,ProcessLookupError): pass
    for _ in range(40):
        if not p.exists(): break
        time.sleep(.1)
    subprocess.Popen([sys.executable,__file__,'start'],env=restart_env,start_new_session=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    sys.exit(0)
if cmd != 'start': sys.exit('Use start, restart, lock or locked')
f=(run/'session.lock').open('w')
try: fcntl.flock(f,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError: sys.exit(0)
(run/'supervisor.pid').write_text(str(os.getpid()))
children=[]
def stop(*_):
    for p in children:
        if p.poll() is None:
            try: os.killpg(p.pid,signal.SIGTERM)
            except ProcessLookupError: pass
    (run/'supervisor.pid').unlink(missing_ok=True)
    sys.exit(0)
signal.signal(signal.SIGTERM,stop);signal.signal(signal.SIGINT,stop);signal.signal(signal.SIGHUP,stop)
conf=Path(os.environ.get('XDG_CONFIG_HOME',Path.home()/'.config'))
subprocess.run(['ms-settings','generate'],stdout=subprocess.DEVNULL)
env=dict(os.environ,MS_STARTUP='1',MS_RUN=str(run))
def compositor_alive():
    # The Hyprland this session belongs to. Once it has gone (logout), its control socket is removed: the
    # supervisor must end with it, or it would keep the session lock, restart the shell into the next login
    # and leave that login without its own idle lock.
    sig=os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'); rt=os.environ.get('XDG_RUNTIME_DIR')
    return not sig or not rt or (Path(rt)/'hypr'/sig/'.socket.sock').exists()
state=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))/'machinespirit'
state.mkdir(parents=True,exist_ok=True)
logfile=state/'session.log'
# Keep the previous run's output for diagnosis; start over only when the log has grown large.
with logfile.open('a' if logfile.exists() and logfile.stat().st_size<1_000_000 else 'w') as log:
    def start_shell(env): return subprocess.Popen(['quickshell','-c','machinespirit'],env=env,stdout=log,stderr=log,start_new_session=True)
    children.append(start_shell(env))
    shell_starts=[time.monotonic()]
    if (conf/'hypr/hyprlock.conf').exists():
        if shutil.which('hypridle'): children.append(subprocess.Popen(['hypridle','-c',str(conf/'machinespirit/hypridle.conf')],stdout=log,stderr=log,start_new_session=True))
    # the privacy daemon needs no display, so it would outlive a supervisor killed at logout: it dies with it instead
    PRIVACY=(['setpriv','--pdeathsig','TERM'] if shutil.which('setpriv') else [])+['ms-privacy','daemon']
    children.append(subprocess.Popen(PRIVACY,stdout=log,stderr=log,start_new_session=True))
    idleconf=conf/'machinespirit/hypridle.conf'
    stamp=idleconf.stat().st_mtime_ns if idleconf.exists() else 0
    daemon_started=time.monotonic()
    try:
        while True:
            if not compositor_alive(): break
            if children[0].poll() is not None:
                # A shell that died on its own is started again (a lock it held is taken over at once); a clean exit ends the session helpers.
                now_=time.monotonic(); shell_starts=[t for t in shell_starts if now_-t<60]
                if children[0].returncode==0 or len(shell_starts)>=5: break
                print('The shell exited with',children[0].returncode,'and is started again',file=log,flush=True)
                time.sleep(.5); children[0]=start_shell({k:v for k,v in env.items() if k!='MS_STARTUP'}); shell_starts.append(time.monotonic())
            time.sleep(1)
            now=idleconf.stat().st_mtime_ns if idleconf.exists() else 0
            if now != stamp and len(children)>2:
                children[1].terminate()
                try: children[1].wait(timeout=3)
                except subprocess.TimeoutExpired: children[1].kill(); children[1].wait()
                children[1]=subprocess.Popen(['hypridle','-c',str(idleconf)],stdout=log,stderr=log,start_new_session=True)
                stamp=now
            # The privacy daemon owns the loopback proxy; without it the shell stays offline until the next login.
            if children[-1].poll() is not None and time.monotonic()-daemon_started>5:
                children[-1]=subprocess.Popen(PRIVACY,stdout=log,stderr=log,start_new_session=True)
                daemon_started=time.monotonic()
    finally: stop()
