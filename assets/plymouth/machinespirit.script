# [ PURITY SEAL ] Preserve the path back to the console.
Window.SetBackgroundTopColor(0.025, 0.035, 0.03);
Window.SetBackgroundBottomColor(0.015, 0.02, 0.018);
title.image = Image.Text("M A C H I N E S P I R I T", 0.65, 0.8, 0.55);
title.sprite = Sprite(title.image);
title.sprite.SetPosition(Window.GetWidth()/2-title.image.GetWidth()/2, Window.GetHeight()/2-30, 1);
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.5, 0.6, 0.45);
    message.sprite.SetImage(message.image);
    message.sprite.SetPosition(Window.GetWidth()/2-message.image.GetWidth()/2,Window.GetHeight()/2+30,2);
}
Plymouth.SetMessageFunction(message_callback);
fun password_callback(prompt, bullets) {
    text = prompt + " ";
    for (i = 0; i < bullets; i++) text += "*";
    message_callback(text);
}
Plymouth.SetDisplayPasswordFunction(password_callback);
fun normal_callback() { message_callback("THE INSTRUMENTS AWAKEN"); }
Plymouth.SetDisplayNormalFunction(normal_callback);
normal_callback();
